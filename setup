#!/bin/bash
# memory-graph setup
#
# Mode A — in-place (after curl extraction):
#   curl -sL https://github.com/SundaraSwani/memory-graph/archive/refs/heads/main.tar.gz \
#     | tar -xz --strip-components=1 && bash setup
#
# Mode B — remote (toolkit already at ~/.cursor/skills/memory-graph/):
#   cd /your/project && ~/.cursor/skills/memory-graph/setup

set -euo pipefail

# ── IDE selection (--ide=cursor|copilot|both) ────────────────────────────
IDE_TARGET=""
for arg in "$@"; do
  case "$arg" in
    --ide=*) IDE_TARGET="${arg#--ide=}" ;;
  esac
done

# Auto-detect IDE if not specified
_detect_ide() {
  local has_cursor=false has_copilot=false
  [[ -d "$TARGET/.cursor" ]] && has_cursor=true
  [[ -d "$TARGET/.github/copilot" || -d "$TARGET/.github/hooks" ]] && has_copilot=true
  
  if $has_cursor && $has_copilot; then
    echo "both"
  elif $has_copilot; then
    echo "copilot"
  else
    echo "cursor"  # default
  fi
}

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
TARGET=$(pwd)
REPO_NAME=$(basename "$TARGET")

if [[ -z "$IDE_TARGET" ]]; then
  IDE_TARGET=$(_detect_ide)
fi

echo "IDE target: $IDE_TARGET"

# Detect mode:
# In-place = setup script is running from the target project itself
# Remote   = setup script lives somewhere else (e.g. ~/.cursor/skills/memory-graph/)
if [ "$SCRIPT_DIR" = "$TARGET" ]; then
  MODE="inplace"
else
  MODE="remote"
fi

echo "memory-graph setup ($MODE mode) → $TARGET ($REPO_NAME)"
echo ""

# ── In-place mode: files already extracted, just configure ────────────────
if [ "$MODE" = "inplace" ]; then

  # Fix permissions
  chmod +x "$TARGET/setup" "$TARGET/post-commit.sh" \
           "$TARGET/.cursor/hooks/on-session-end.sh" \
           "$TARGET/.cursor/hooks/track-changed-files.sh" \
           "$TARGET/.cursor/hooks/compress-memory.py" \
           "$TARGET/.cursor/hooks/graph-scout-local.py" \
           "$TARGET/.cursor/hooks/semantic-compress-ollama.py" \
           "$TARGET/.cursor/hooks/assemble-agent-brief.py" \
           "$TARGET/.cursor/hooks/compress-tool-output.py" \
           "$TARGET/.cursor/hooks/compress-tool-output.sh" \
           "$TARGET/.cursor/hooks/on-session-start.sh" \
           "$TARGET/.cursor/hooks/fill-session-from-transcript.py" \
           "$TARGET/.cursor/hooks/ollama-context-gateway.py" \
           "$TARGET/.cursor/hooks/mg_config.py" \
           "$TARGET/.cursor/hooks/graph-summary-main.py" \
           "$TARGET/scripts/test.sh" \
           "$TARGET/scripts/test-static.sh" \
           "$TARGET/scripts/test-compress-sandbox.sh" \
           "$TARGET/scripts/graph-scout-local.sh" \
           "$TARGET/scripts/enable-graph-scout-local.sh" \
           "$TARGET/scripts/check-graph-scout-local.sh" \
           "$TARGET/scripts/enable-token-savers.sh" \
           "$TARGET/scripts/enable-token-first.sh" 2>/dev/null || true
  chmod +x "$TARGET/scripts/upgrade-memory-graph.sh" 2>/dev/null || true
  chmod +x "$TARGET/scripts/adapters/"*.sh 2>/dev/null || true

  # Dev hooks: pre-push runs sandbox tests before git push
  if [ -f "$TARGET/scripts/install-dev-hooks.sh" ]; then
    bash "$TARGET/scripts/install-dev-hooks.sh" 2>/dev/null || true
  fi

  # Replace [REPO_NAME] placeholder in rules and CLAUDE.md
  for f in \
    "$TARGET/.cursor/rules/main.mdc" \
    "$TARGET/.cursor/rules/sdlc.mdc" \
    "$TARGET/CLAUDE.md"; do
    [ -f "$f" ] && sed -i '' "s/\[REPO_NAME\]/$REPO_NAME/g" "$f" 2>/dev/null || true
  done
  echo "[ok] .cursor/ configured for $REPO_NAME"

# ── Remote mode: copy files into target project ───────────────────────────
else

  # Hooks
  mkdir -p "$TARGET/.cursor/hooks"
  cp "$SCRIPT_DIR/.cursor/hooks/on-session-end.sh" "$TARGET/.cursor/hooks/"
  chmod +x "$TARGET/.cursor/hooks/on-session-end.sh"
  cp "$SCRIPT_DIR/.cursor/hooks/track-changed-files.sh" "$TARGET/.cursor/hooks/"
  chmod +x "$TARGET/.cursor/hooks/track-changed-files.sh"
  cp "$SCRIPT_DIR/.cursor/hooks/compress-memory.py" "$TARGET/.cursor/hooks/"
  chmod +x "$TARGET/.cursor/hooks/compress-memory.py"

  if [ ! -f "$TARGET/.cursor/hooks.json" ]; then
    cp "$SCRIPT_DIR/.cursor/hooks.json" "$TARGET/.cursor/"
  else
    echo "[warn] .cursor/hooks.json exists — merge afterFileEdit + stop hooks from memory-graph"
  fi
  echo "[ok] .cursor/hooks/ ready"

  # Rules
  mkdir -p "$TARGET/.cursor/rules"
  for rule in main.mdc sdlc.mdc; do
    if [ ! -f "$TARGET/.cursor/rules/$rule" ]; then
      sed "s/\[REPO_NAME\]/$REPO_NAME/g" \
        "$SCRIPT_DIR/.cursor/rules/$rule" > "$TARGET/.cursor/rules/$rule"
    fi
  done
  echo "[ok] .cursor/rules/ ready"

  # Root files
  [ ! -f "$TARGET/CLAUDE.md" ] && \
    sed "s/\[REPO_NAME\]/$REPO_NAME/g" "$SCRIPT_DIR/CLAUDE.md" > "$TARGET/CLAUDE.md"
  [ ! -f "$TARGET/memory.md" ] && cp "$SCRIPT_DIR/memory.md" "$TARGET/memory.md"
  [ ! -f "$TARGET/.gitignore" ] && cp "$SCRIPT_DIR/.gitignore" "$TARGET/.gitignore"
  [ ! -f "$TARGET/post-commit.sh" ] && \
    cp "$SCRIPT_DIR/post-commit.sh" "$TARGET/post-commit.sh" && \
    chmod +x "$TARGET/post-commit.sh"
  mkdir -p "$TARGET/sessions" "$TARGET/memory" "$TARGET/.memory-graph" "$TARGET/scripts"
  cp "$SCRIPT_DIR/.memory-graph/ollama.example.yaml" "$TARGET/.memory-graph/" 2>/dev/null || true
  cp "$SCRIPT_DIR/.memory-graph/config.example.yaml" "$TARGET/.memory-graph/" 2>/dev/null || true
  cp "$SCRIPT_DIR/.cursor/hooks/semantic-compress-ollama.py" "$TARGET/.cursor/hooks/" 2>/dev/null || true
  chmod +x "$TARGET/.cursor/hooks/semantic-compress-ollama.py" 2>/dev/null || true
  cp "$SCRIPT_DIR/scripts/check-ollama.sh" "$TARGET/scripts/" 2>/dev/null || true
  cp "$SCRIPT_DIR/scripts/enable-semantic-ollama.sh" "$TARGET/scripts/" 2>/dev/null || true
  cp "$SCRIPT_DIR/.cursor/hooks/graph-scout-local.py" "$TARGET/.cursor/hooks/" 2>/dev/null || true
  chmod +x "$TARGET/.cursor/hooks/graph-scout-local.py" 2>/dev/null || true
  cp "$SCRIPT_DIR/scripts/graph-scout-local.sh" "$TARGET/scripts/" 2>/dev/null || true
  cp "$SCRIPT_DIR/scripts/enable-graph-scout-local.sh" "$TARGET/scripts/" 2>/dev/null || true
  cp "$SCRIPT_DIR/scripts/check-graph-scout-local.sh" "$TARGET/scripts/" 2>/dev/null || true
  cp "$SCRIPT_DIR/.cursor/hooks/assemble-agent-brief.py" "$TARGET/.cursor/hooks/" 2>/dev/null || true
  cp "$SCRIPT_DIR/.cursor/hooks/compress-tool-output.py" "$TARGET/.cursor/hooks/" 2>/dev/null || true
  cp "$SCRIPT_DIR/.cursor/hooks/compress-tool-output.sh" "$TARGET/.cursor/hooks/" 2>/dev/null || true
  cp "$SCRIPT_DIR/.cursor/hooks/on-session-start.sh" "$TARGET/.cursor/hooks/" 2>/dev/null || true
  cp "$SCRIPT_DIR/.cursor/hooks/fill-session-from-transcript.py" "$TARGET/.cursor/hooks/" 2>/dev/null || true
  cp "$SCRIPT_DIR/.cursor/hooks/ollama-context-gateway.py" "$TARGET/.cursor/hooks/" 2>/dev/null || true
  cp "$SCRIPT_DIR/.cursor/hooks/mg_config.py" "$TARGET/.cursor/hooks/" 2>/dev/null || true
  cp "$SCRIPT_DIR/.cursor/hooks/graph-summary-main.py" "$TARGET/.cursor/hooks/" 2>/dev/null || true
  cp "$SCRIPT_DIR/memory/README.md" "$TARGET/memory/" 2>/dev/null || true
  cp "$SCRIPT_DIR/scripts/enable-token-savers.sh" "$TARGET/scripts/" 2>/dev/null || true
  cp "$SCRIPT_DIR/scripts/enable-token-first.sh" "$TARGET/scripts/" 2>/dev/null || true
  cp "$SCRIPT_DIR/scripts/upgrade-memory-graph.sh" "$TARGET/scripts/" 2>/dev/null || true
  chmod +x "$TARGET/scripts/graph-scout-local.sh" "$TARGET/scripts/enable-graph-scout-local.sh" \
    "$TARGET/scripts/check-graph-scout-local.sh" "$TARGET/scripts/enable-token-savers.sh" \
    "$TARGET/scripts/upgrade-memory-graph.sh" 2>/dev/null || true
  chmod +x "$TARGET/.cursor/hooks/assemble-agent-brief.py" \
    "$TARGET/.cursor/hooks/compress-tool-output.py" \
    "$TARGET/.cursor/hooks/compress-tool-output.sh" \
    "$TARGET/.cursor/hooks/on-session-start.sh" \
    "$TARGET/.cursor/hooks/fill-session-from-transcript.py" \
    "$TARGET/.cursor/hooks/ollama-context-gateway.py" 2>/dev/null || true

  # Team knowledge: AGENTS.md + agent skills
  if [ -f "$SCRIPT_DIR/AGENTS.md" ]; then
    cp "$SCRIPT_DIR/AGENTS.md" "$TARGET/AGENTS.md"
  fi
  for skill in \
    memory-graph-conventions memory-graph-hooks memory-graph-testing \
    ship-feature graph-scout semantic-compress memory-graph-setup grill-me; do
    if [ -f "$SCRIPT_DIR/.agents/skills/$skill/SKILL.md" ]; then
      mkdir -p "$TARGET/.agents/skills/$skill"
      cp "$SCRIPT_DIR/.agents/skills/$skill/SKILL.md" "$TARGET/.agents/skills/$skill/"
      if [ -f "$SCRIPT_DIR/.agents/skills/$skill/WORKFLOWS.md" ]; then
        cp "$SCRIPT_DIR/.agents/skills/$skill/WORKFLOWS.md" "$TARGET/.agents/skills/$skill/"
      fi
    fi
  done

  echo "[ok] root files ready"

fi

# ── Copilot hooks installation (--ide=copilot or --ide=both) ──────────────
_install_copilot_hooks() {
  echo ""
  echo "Installing Copilot hooks..."
  
  mkdir -p "$TARGET/.github/hooks"
  mkdir -p "$TARGET/scripts/adapters"
  
  # Copy hook config
  if [ -f "$SCRIPT_DIR/.github/hooks/memory-graph.json" ]; then
    cp "$SCRIPT_DIR/.github/hooks/memory-graph.json" "$TARGET/.github/hooks/"
  fi
  
  # Copy copilot-instructions.md
  if [ -f "$SCRIPT_DIR/.github/copilot-instructions.md" ]; then
    cp "$SCRIPT_DIR/.github/copilot-instructions.md" "$TARGET/.github/"
  fi
  
  # Copy adapters
  for adapter in copilot-session-end.sh copilot-session-start.sh copilot-post-tool.sh; do
    if [ -f "$SCRIPT_DIR/scripts/adapters/$adapter" ]; then
      cp "$SCRIPT_DIR/scripts/adapters/$adapter" "$TARGET/scripts/adapters/"
      chmod +x "$TARGET/scripts/adapters/$adapter"
    fi
  done
  
  echo "[ok] .github/hooks/ configured for Copilot"
}

if [[ "$IDE_TARGET" == "copilot" || "$IDE_TARGET" == "both" ]]; then
  _install_copilot_hooks
fi

# ── Both modes: git post-commit hook ──────────────────────────────────────
if [ -d "$TARGET/.git" ]; then
  HOOK_FILE="$TARGET/.git/hooks/post-commit"
  HOOK_LINE='bash "$(git rev-parse --show-toplevel)/post-commit.sh"'
  if [ ! -f "$HOOK_FILE" ]; then
    printf '#!/bin/bash\n%s\n' "$HOOK_LINE" > "$HOOK_FILE"
    chmod +x "$HOOK_FILE"
    echo "[ok] .git/hooks/post-commit installed"
  elif ! grep -q "post-commit\.sh" "$HOOK_FILE" 2>/dev/null; then
    printf '\n# memory-graph\n%s\n' "$HOOK_LINE" >> "$HOOK_FILE"
    echo "[ok] Appended to existing post-commit hook"
  else
    echo "[ok] post-commit hook already set"
  fi
else
  echo "[warn] No .git found — run 'git init' then re-run setup to install post-commit hook"
fi

# ── Both modes: graphify ──────────────────────────────────────────────────
echo ""
echo "Checking graphify..."
python3 -c "import graphify" 2>/dev/null || \
  python3 -m pip install graphifyy -q 2>/dev/null || \
  python3 -m pip install graphifyy -q --break-system-packages 2>/dev/null || \
  echo "[warn] graphify install failed — run: pip install graphifyy"
python3 -c "import graphify" 2>/dev/null && echo "[ok] graphify ready" || echo "[warn] graphify not found"

# ── Both modes: gstack (opt-in) ───────────────────────────────────────────
echo ""
if [ "${INSTALL_GSTACK:-}" = "1" ]; then
  echo "Checking gstack..."
  GSTACK_DIR="$HOME/.cursor/skills/gstack"
  if [ ! -d "$GSTACK_DIR" ]; then
    echo "Installing gstack for Cursor..."
    git clone --single-branch --depth 1 https://github.com/garrytan/gstack.git "$GSTACK_DIR" 2>/dev/null && \
      (cd "$GSTACK_DIR" && ./setup --host cursor 2>/dev/null) && \
      echo "[ok] gstack installed" || \
      echo "[warn] gstack install failed — run: git clone https://github.com/garrytan/gstack.git $GSTACK_DIR"
  else
    echo "[ok] gstack already installed"
  fi
else
  echo "[skip] gstack not installed (optional). Run: INSTALL_GSTACK=1 bash setup"
fi

# ── Done ──────────────────────────────────────────────────────────────────
echo ""
echo "Done. memory-graph active in $TARGET (IDE: $IDE_TARGET)"
echo ""
echo "Next:"
echo "  /graphify .              — build knowledge graph + main.mdc Codebase summary"
echo "  bash scripts/enable-token-savers.sh  — agent brief + tool output compress"
echo "  bash scripts/enable-graph-scout-local.sh — local graph scout (optional)"
echo "  /grill-me                — optional, for new features"
echo "  INSTALL_GSTACK=1 bash setup  — add gstack SDLC skills (/spec, /review, /qa, /ship)"
echo "  bash scripts/test.sh         — run sandbox tests before push"
echo ""
echo "IDE options:"
echo "  bash setup --ide=cursor   — Cursor only (default)"
echo "  bash setup --ide=copilot  — GitHub Copilot only"
echo "  bash setup --ide=both     — install for both IDEs"
echo "  bash scripts/upgrade-memory-graph.sh — refresh hooks/scripts/.agents only"
